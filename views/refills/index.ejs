<%- include('../partials/header') %>

<h1><%= title %></h1>
<p><a href="/refills/new" class="button-link">Add New Refill</a></p>

<% if (refills && refills.length) { %>
    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Odometer (km)</th>
                <th>Refill Cost (Rs.)</th>
                <th>Fuel Price (Rs./L)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% refills.forEach(refill => { %>
                <tr>
                    <td><%= new Date(refill.date).toLocaleDateString() %></td>
                    <td><%= refill.odometerReading %></td>
                    <td><%= refill.refillCost.toFixed(2) %></td>
                    <td><%= refill.fuelPrice.toFixed(2) %></td>
                    <td class="actions-cell">
                        <a href="/refills/<%= refill.id %>/edit" class="button-link">Edit</a>
                        <form action="/refills/<%= refill.id %>/delete" method="POST" style="display:inline;">
                            <button type="submit" onclick="return confirm('Are you sure you want to delete this refill?');">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <p>No refills logged yet.</p>
<% } %>

<%- include('../partials/footer') %>
