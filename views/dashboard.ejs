<%- include('partials/header') %>

<div class="flex flex-wrap justify-between items-center mb-6 gap-4"> <!-- Added gap-4 for spacing on small screens -->
    <h1 class="text-3xl font-bold text-gray-800">Dashboard</h1>
    <a href="/refills/new"
       class="bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded-lg shadow-md inline-flex items-center transition-colors duration-150 ease-in-out">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        Log New Refill
    </a>
</div>

<% if (typeof stats !== 'undefined' && stats.totalRefills > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <!-- Total Refills Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 transform hover:scale-105 transition-transform duration-300 ease-in-out">
            <div class="flex items-center">
                <div class="mr-4 bg-blue-500 text-white p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Total Refills</h2>
                    <p class="text-3xl font-semibold text-gray-800"><%= stats.totalRefills %></p>
                </div>
            </div>
        </div>

        <!-- Total Spent Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 transform hover:scale-105 transition-transform duration-300 ease-in-out">
            <div class="flex items-center">
                <div class="mr-4 bg-green-500 text-white p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Total Spent</h2>
                    <p class="text-3xl font-semibold text-gray-800">Rs. <%= stats.totalSpent.toFixed(2) %></p>
                </div>
            </div>
        </div>

        <!-- Overall Km/Litre Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 transform hover:scale-105 transition-transform duration-300 ease-in-out">
            <div class="flex items-center">
                <div class="mr-4 bg-yellow-500 text-white p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Overall Km/Litre</h2>
                    <p class="text-3xl font-semibold text-gray-800"><%= stats.overallKmPerLitre.toFixed(2) %></p>
                </div>
            </div>
        </div>

        <!-- Overall L/100Km Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 transform hover:scale-105 transition-transform duration-300 ease-in-out">
            <div class="flex items-center">
                <div class="mr-4 bg-red-500 text-white p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Overall L/100Km</h2>
                    <p class="text-3xl font-semibold text-gray-800"><%= stats.overallLitrePer100Km.toFixed(2) %></p>
                </div>
            </div>
        </div>

        <% if (stats.totalRefills > 1) { %>
        <!-- Overall Cost/Km Card -->
        <div class="bg-white shadow-lg rounded-xl p-6 transform hover:scale-105 transition-transform duration-300 ease-in-out">
            <div class="flex items-center">
                <div class="mr-4 bg-indigo-500 text-white p-3 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Overall Cost/Km</h2>
                    <p class="text-3xl font-semibold text-gray-800">Rs. <%= stats.overallCostPerKm.toFixed(2) %></p>
                </div>
            </div>
        </div>
        <% } %>
    </div>

    <!-- Charts container - canvases will always be rendered if totalRefills > 0 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="chart-card">
            <h2>Fuel Consumption (L/100Km)</h2>
            <canvas id="litrePer100KmChart"></canvas>
        </div>
        <div class="chart-card">
            <h2>Cost per Km</h2>
            <canvas id="costPerKmChart"></canvas>
        </div>
        <div class="chart-card">
            <h2>Days Between Refills</h2>
            <canvas id="daysBetweenRefillsChart"></canvas>
        </div>
    </div>

<% } else { %>
    <p class="text-center">No refill data available to display statistics. <a href="/refills/new">Add your first refill!</a></p>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const stats = <%- JSON.stringify(typeof stats !== 'undefined' ? stats : {}) %>;
    const refillDetails = stats.refillDetails || [];

    // Litre/100Km Chart (can show with 1+ refills)
    const litrePer100KmCanvas = document.getElementById('litrePer100KmChart');
    if (litrePer100KmCanvas && refillDetails.length > 0) {
      const litrePer100KmLabels = refillDetails.map(r => new Date(r.date).toLocaleDateString());
      const litrePer100KmData = refillDetails.map(r => parseFloat(r.litrePer100Km) || 0);
      new Chart(litrePer100KmCanvas, {
        type: 'line',
        data: {
          labels: litrePer100KmLabels,
          datasets: [{
            label: 'L/100Km',
            data: litrePer100KmData,
            borderColor: 'rgb(255, 99, 132)',
            backgroundColor: 'rgba(255, 99, 132, 0.5)',
            tension: 0.1
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    } else if (litrePer100KmCanvas) {
        const ctx = litrePer100KmCanvas.getContext('2d');
        ctx.font = '16px Arial'; ctx.textAlign = 'center';
        ctx.fillText('Not enough data for this chart.', litrePer100KmCanvas.width / 2, litrePer100KmCanvas.height / 2);
    }

    // Cost per Km Chart (can show with 1+ refills)
    const costPerKmCanvas = document.getElementById('costPerKmChart');
    if (costPerKmCanvas && refillDetails.length > 0) {
      const costPerKmLabels = refillDetails.map(r => new Date(r.date).toLocaleDateString());
      const costPerKmData = refillDetails.map(r => parseFloat(r.costPerKm) || 0);
      new Chart(costPerKmCanvas, {
        type: 'line',
        data: {
          labels: costPerKmLabels,
          datasets: [{
            label: 'Cost per Km (Rs.)',
            data: costPerKmData,
            borderColor: 'rgb(54, 162, 235)',
            backgroundColor: 'rgba(54, 162, 235, 0.5)',
            tension: 0.1
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    } else if (costPerKmCanvas) {
        const ctx = costPerKmCanvas.getContext('2d');
        ctx.font = '16px Arial'; ctx.textAlign = 'center';
        ctx.fillText('Not enough data for this chart.', costPerKmCanvas.width / 2, costPerKmCanvas.height / 2);
    }

    // Days Between Refills Chart (requires 2+ refills)
    const daysBetweenRefillsCanvas = document.getElementById('daysBetweenRefillsChart');
    if (daysBetweenRefillsCanvas && refillDetails.length > 1) {
      const daysLabels = refillDetails.slice(1).map(r => new Date(r.date).toLocaleDateString());
      const daysData = refillDetails.slice(1).map(r => parseInt(r.daysSinceLastRefill) || 0);
      new Chart(daysBetweenRefillsCanvas, {
        type: 'bar',
        data: {
          labels: daysLabels,
          datasets: [{
            label: 'Days Between Refills',
            data: daysData,
            borderColor: 'rgb(75, 192, 192)',
            backgroundColor: 'rgba(75, 192, 192, 0.5)',
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    } else if (daysBetweenRefillsCanvas) {
        const ctx = daysBetweenRefillsCanvas.getContext('2d');
        ctx.font = '16px Arial'; ctx.textAlign = 'center';
        ctx.fillText('Need at least two refills to show days between them.', daysBetweenRefillsCanvas.width / 2, daysBetweenRefillsCanvas.height / 2);
    }
  });
</script>

<%- include('partials/footer') %>
