<%- include('partials/header') %>

<h1>Dashboard</h1>

<% if (typeof stats !== 'undefined' && stats.totalRefills > 0) { %>
    <div class="stats-cards-container">
        <div class="stat-card">
            <h2>Total Refills</h2>
            <p class="stat-value"><%= stats.totalRefills %></p>
        </div>
        <div class="stat-card">
            <h2>Total Spent</h2>
            <p class="stat-value">Rs. <%= stats.totalSpent.toFixed(2) %></p>
        </div>
        <div class="stat-card">
            <h2>Overall Km/Litre</h2>
            <p class="stat-value"><%= stats.overallKmPerLitre.toFixed(2) %></p>
        </div>
        <div class="stat-card">
            <h2>Overall L/100Km</h2>
            <p class="stat-value"><%= stats.overallLitrePer100Km.toFixed(2) %></p>
        </div>
        <% if (stats.totalRefills > 1) { %>
        <div class="stat-card">
            <h2>Overall Cost/Km</h2>
            <p class="stat-value">Rs. <%= stats.overallCostPerKm.toFixed(2) %></p>
        </div>
        <% } %>
    </div>

    <!-- Charts container - canvases will always be rendered if totalRefills > 0 -->
    <div class="charts-container">
        <div class="chart-card">
            <h2>Fuel Consumption (L/100Km)</h2>
            <canvas id="litrePer100KmChart"></canvas>
        </div>
        <div class="chart-card">
            <h2>Cost per Km</h2>
            <canvas id="costPerKmChart"></canvas>
        </div>
        <div class="chart-card">
            <h2>Days Between Refills</h2>
            <canvas id="daysBetweenRefillsChart"></canvas>
        </div>
    </div>

<% } else { %>
    <p class="text-center">No refill data available to display statistics. <a href="/refills/new">Add your first refill!</a></p>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const stats = <%- JSON.stringify(typeof stats !== 'undefined' ? stats : {}) %>;
    const refillDetails = stats.refillDetails || [];

    // Litre/100Km Chart (can show with 1+ refills)
    const litrePer100KmCanvas = document.getElementById('litrePer100KmChart');
    if (litrePer100KmCanvas && refillDetails.length > 0) {
      const litrePer100KmLabels = refillDetails.map(r => new Date(r.date).toLocaleDateString());
      const litrePer100KmData = refillDetails.map(r => parseFloat(r.litrePer100Km) || 0);
      new Chart(litrePer100KmCanvas, {
        type: 'line',
        data: {
          labels: litrePer100KmLabels,
          datasets: [{
            label: 'L/100Km',
            data: litrePer100KmData,
            borderColor: 'rgb(255, 99, 132)',
            backgroundColor: 'rgba(255, 99, 132, 0.5)',
            tension: 0.1
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    } else if (litrePer100KmCanvas) {
        const ctx = litrePer100KmCanvas.getContext('2d');
        ctx.font = '16px Arial'; ctx.textAlign = 'center';
        ctx.fillText('Not enough data for this chart.', litrePer100KmCanvas.width / 2, litrePer100KmCanvas.height / 2);
    }

    // Cost per Km Chart (can show with 1+ refills)
    const costPerKmCanvas = document.getElementById('costPerKmChart');
    if (costPerKmCanvas && refillDetails.length > 0) {
      const costPerKmLabels = refillDetails.map(r => new Date(r.date).toLocaleDateString());
      const costPerKmData = refillDetails.map(r => parseFloat(r.costPerKm) || 0);
      new Chart(costPerKmCanvas, {
        type: 'line',
        data: {
          labels: costPerKmLabels,
          datasets: [{
            label: 'Cost per Km (Rs.)',
            data: costPerKmData,
            borderColor: 'rgb(54, 162, 235)',
            backgroundColor: 'rgba(54, 162, 235, 0.5)',
            tension: 0.1
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    } else if (costPerKmCanvas) {
        const ctx = costPerKmCanvas.getContext('2d');
        ctx.font = '16px Arial'; ctx.textAlign = 'center';
        ctx.fillText('Not enough data for this chart.', costPerKmCanvas.width / 2, costPerKmCanvas.height / 2);
    }

    // Days Between Refills Chart (requires 2+ refills)
    const daysBetweenRefillsCanvas = document.getElementById('daysBetweenRefillsChart');
    if (daysBetweenRefillsCanvas && refillDetails.length > 1) {
      const daysLabels = refillDetails.slice(1).map(r => new Date(r.date).toLocaleDateString());
      const daysData = refillDetails.slice(1).map(r => parseInt(r.daysSinceLastRefill) || 0);
      new Chart(daysBetweenRefillsCanvas, {
        type: 'bar',
        data: {
          labels: daysLabels,
          datasets: [{
            label: 'Days Between Refills',
            data: daysData,
            borderColor: 'rgb(75, 192, 192)',
            backgroundColor: 'rgba(75, 192, 192, 0.5)',
          }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });
    } else if (daysBetweenRefillsCanvas) {
        const ctx = daysBetweenRefillsCanvas.getContext('2d');
        ctx.font = '16px Arial'; ctx.textAlign = 'center';
        ctx.fillText('Need at least two refills to show days between them.', daysBetweenRefillsCanvas.width / 2, daysBetweenRefillsCanvas.height / 2);
    }
  });
</script>

<%- include('partials/footer') %>
