<%- include('../../partials/header') %>

<h1><%= title %></h1>
<form action="<%= actionUrl %>" method="POST">
    <% if (refill && refill.id) { %>
        <!-- Standard POST, backend logic handles it as update -->
    <% } %>
    <div>
        <label for="date">Date:</label>
        <input type="date" id="date" name="date" value="<%= refill.date ? new Date(refill.date).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>" required>
    </div>
    <div>
        <label for="odometerReading">Odometer Reading (kms):</label>
        <input type="number" id="odometerReading" name="odometerReading" value="<%= refill.odometerReading || '' %>" required>
    </div>
    <div>
        <label for="refillCost">Refill Cost (Rs.):</label>
        <input type="number" id="refillCost" name="refillCost" step="0.01" value="<%= refill.refillCost ? refill.refillCost.toFixed(2) : '' %>" required>
    </div>
    <div>
        <label for="fuelPrice">Fuel Price (Rs./Litre) at time of refill:</label>
        <% if (refill && refill.id) { %> 
            <input type="number" id="fuelPrice" name="fuelPrice" step="0.01" value="<%= refill.fuelPrice.toFixed(2) %>" required>
        <% } else { %>
            <input type="number" id="fuelPrice" name="fuelPrice" step="0.01" value="<%= currentFuelPrice.toFixed(2) %>" readonly required>
            <small>Current system fuel price: <%= currentFuelPrice.toFixed(2) %> (from settings). This will be saved with the refill.</small>
        <% } %>
    </div>
    <button type="submit">Save Refill</button>
    <a href="/refills" class="button-link" style="background-color: #6c757d;">Cancel</a>
</form>

<%- include('../../partials/footer') %>
